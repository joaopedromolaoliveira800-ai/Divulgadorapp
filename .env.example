# GEMINI_API_KEY: Required for Gemini AI API calls (Ad generation, keywords, copy).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google OAuth 2.0 Credentials (for official Google Ads API OAuth flow)
# Scope: https://www.googleapis.com/auth/adwords
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# Google Ads API Official Developer Token
# Pre-configured with user developer token
GOOGLE_ADS_DEVELOPER_TOKEN="obopXETQW2Vmfba7OhvGQ"

# Database connection URL (PostgreSQL / Relational database)
DATABASE_URL="postgresql://user:password@localhost:5432/divulgadorads"

# Session encryption secret
SESSION_SECRET="super-secret-session-key-divulgadorads-2026"

